# =============================================================
# CONFIGURAÇÕES DA APLICAÇÃO
# =============================================================

# Ambiente de execução (development, production)
NODE_ENV=development

# Porta do servidor
PORT=3333

# URLs da aplicação
APP_URL=http://localhost:3333
CLIENT_URL=http://localhost:5173

# =============================================================
# BANCO DE DADOS (PostgreSQL/Supabase)
# =============================================================

# URL de conexão completa com o banco de dados
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# IMPORTANTE: Use %40 para @ na senha (URL encoding)
# Exemplo: senha @Pablosilva621 vira %40Pablosilva621
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_ID:%40YOUR_PASSWORD@aws-1-us-west-2.pooler.supabase.com:6543/postgres

# =============================================================
# AUTENTICAÇÃO JWT
# =============================================================

# Chave secreta para assinatura de tokens JWT (mínimo 32 caracteres)
JWT_SECRET="YOUR_RANDOM_SECRET_KEY_HERE"

# Tempo de expiração do token (exemplos: 1h, 7d, 30d)
JWT_EXPIRES_IN=7d

# =============================================================
# GITHUB (OPCIONAL - Para integração com releases)
# =============================================================

# Nome do repositório no formato: usuário/repositório
GITHUB_REPOSITORY=your-username/your-repo

# Token de acesso pessoal do GitHub (com permissão de leitura)
GITHUB_TOKEN=ghp_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
