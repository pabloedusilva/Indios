# =============================================================
# CONFIGURAÇÕES FISCAIS - Focus NFe API (EXEMPLO)
# =============================================================

# ── Ambiente da API ──────────────────────────────────────────
# homologacao = testes (sem validade fiscal)
# producao = notas fiscais reais enviadas para SEFAZ
FOCUS_NFE_ENV=homologacao

# ── Autenticação Focus NFe ───────────────────────────────────
FOCUS_NFE_TOKEN=seu_token_aqui

# ── URLs da API ──────────────────────────────────────────────
FOCUS_NFE_API_HOMOLOGACAO=https://homologacao.focusnfe.com.br
FOCUS_NFE_API_PRODUCAO=https://api.focusnfe.com.br

# ── Configurações de Timeout e Retry ─────────────────────────
FOCUS_NFE_TIMEOUT=30000
FOCUS_NFE_MAX_RETRIES=3

# ── Debug (true para logs detalhados) ────────────────────────
FISCAL_DEBUG=false

# ══════════════════════════════════════════════════════════════
# DADOS DA EMPRESA
# ══════════════════════════════════════════════════════════════

EMPRESA_CNPJ=00000000000000
EMPRESA_IE=000000000000
EMPRESA_RAZAO_SOCIAL=SUA EMPRESA LTDA
EMPRESA_NOME_FANTASIA=Sua Empresa
EMPRESA_CRT=1

# ── Endereço Fiscal ──────────────────────────────────────────
EMPRESA_ENDERECO_LOGRADOURO=Rua Exemplo
EMPRESA_ENDERECO_NUMERO=123
EMPRESA_ENDERECO_COMPLEMENTO=
EMPRESA_ENDERECO_BAIRRO=Centro
EMPRESA_ENDERECO_MUNICIPIO=Sua Cidade
EMPRESA_ENDERECO_UF=UF
EMPRESA_ENDERECO_CEP=00000-000
EMPRESA_ENDERECO_CODIGO_MUNICIPIO=0000000

# ══════════════════════════════════════════════════════════════
# CONFIGURAÇÕES NFE
# ══════════════════════════════════════════════════════════════

NFE_SERIE=1
NFE_PROXIMO_NUMERO=1
